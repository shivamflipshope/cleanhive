RewriteEngine On
RewriteBase /

# 301 Redirect for laundry-service and laundry-service-in-gurgaon to laundry-service-gurgaon
RewriteRule ^laundry-service/?(index\.html)?$ /laundry-service-gurgaon/ [R=301,L,NC]
RewriteRule ^laundry-service-in-gurgaon/?(index\.html)?$ /laundry-service-gurgaon/ [R=301,L,NC]

# Redirect /folder/index.html → /folder/
RewriteCond %{THE_REQUEST} /([^/]+)/index\.html [NC]
RewriteRule ^ %1/ [R=301,L]

# Serve /folder/ → /folder/index.html if it exists
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# If neither file nor folder exists, redirect to page-not-found
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^.*$ /page-not-found/index.html [L,R=404]